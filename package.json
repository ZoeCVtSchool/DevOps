{
  "name": "api-rest-ci-cd",
  "version": "1.0.0",
  "private": true,
  "description": "API REST CRUD con CI/CD a Docker Hub y AWS EC2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "c8 node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "4.22.3"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "supertest": "7.1.3"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "check-coverage": true,
    "branches": 70,
    "lines": 70,
    "statements": 70
  }
}
